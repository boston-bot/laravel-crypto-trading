<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>local.investing-ops.php-fpm</string>
    <key>ProgramArguments</key>
    <array>
        <string>@@PHP_FPM@@</string>
        <string>--nodaemonize</string>
        <string>--fpm-config</string>
        <string>@@RUNTIME@@/php-fpm.conf</string>
    </array>
    <key>WorkingDirectory</key><string>@@APP@@</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>@@BREW@@/bin:@@BREW@@/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>StandardOutPath</key><string>@@LOGS@@/php-fpm.out.log</string>
    <key>StandardErrorPath</key><string>@@LOGS@@/php-fpm.err.log</string>
</dict>
</plist>
