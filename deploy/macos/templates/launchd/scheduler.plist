<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>local.investing-ops.scheduler</string>
    <key>ProgramArguments</key>
    <array>
        <string>@@PHP@@</string>
        <string>@@APP@@/artisan</string>
        <string>schedule:run</string>
        <string>--no-interaction</string>
    </array>
    <key>WorkingDirectory</key><string>@@APP@@</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>@@BREW@@/bin:@@BREW@@/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <!-- All calendar fields omitted means every wall-clock minute; an elapsed interval drifts past due minutes. -->
    <key>StartCalendarInterval</key><dict/>
    <key>StandardOutPath</key><string>@@LOGS@@/scheduler.out.log</string>
    <key>StandardErrorPath</key><string>@@LOGS@@/scheduler.err.log</string>
</dict>
</plist>
