MAX_EXECUTION_PENALTY=0.70
MAX_SPREAD_BPS=180
MAX_SLIPPAGE_BPS=180
MAX_CONSECUTIVE_LOSSES=3
CONSECUTIVE_LOSS_LOOKBACK=8

COINBASE_BASE_URL=https://api.coinbase.com
COINBASE_API_KEY=
COINBASE_API_PRIVATE_KEY=
COINBASE_QUOTE_CURRENCY=USD
COINBASE_TIMEOUT_SECONDS=10
COINBASE_RETRY_TIMES=3
COINBASE_RETRY_SLEEP_MS=200
COINBASE_ENDPOINT_ACCOUNTS=/api/v3/brokerage/accounts
COINBASE_ENDPOINT_ASSETS=/api/v3/brokerage/products
COINBASE_ENDPOINT_ORDERS=/api/v3/brokerage/orders/historical/batch
COINBASE_ENDPOINT_ORDER=/api/v3/brokerage/orders/historical
COINBASE_ENDPOINT_PLACE_ORDER=/api/v3/brokerage/orders
COINBASE_ENDPOINT_QUOTES=/api/v3/brokerage/best_bid_ask
COINBASE_ENDPOINT_CANDLES=/api/v3/brokerage/products/{product_id}/candles
COINBASE_ENDPOINT_TRANSACTION_SUMMARY=/api/v3/brokerage/transaction_summary

# Paper uses the canonical database/Python handoff after the parity and causality
# gates. Set legacy only for diagnostics; changing this never enables live trading.
STRATEGY_ENGINE_DRIVER=database
STRATEGY_ENGINE_SCHEMA_VERSION=2.0
STRATEGY_ENGINE_VERSION=0.2.0
STRATEGY_ENGINE_LEASE_SECONDS=300
STRATEGY_ENGINE_MAX_ATTEMPTS=3
STRATEGY_PROPOSAL_TTL_MINUTES=30
STRATEGY_ENGINE_JOB_TTL_MINUTES=60
STRATEGY_MAX_SIGNAL_AGE_MINUTES=240
MARKET_EVIDENCE_REFRESH_HOURS=336
APPROVAL_MAX_QUOTE_AGE_SECONDS=15
APPROVAL_MAX_PRICE_CHANGE_BPS=75
FEE_SNAPSHOT_MAX_AGE_MINUTES=60
KRAKEN_RETAIL_TAKER_BPS=40
SPREAD_REBALANCE_RESERVE_BPS=5
FEAR_GREED_API_URL=https://api.alternative.me/fng/
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/laravel_crypto_trading

# Local-only operations console and allowlisted process supervisor.
OPERATIONS_LOCAL_ONLY=true
LIVE_CONSOLE_ACTIONS_ENABLED=false
TRADING_RUNTIME_POLL_SECONDS=2
TRADING_RUNTIME_STALE_SECONDS=30
TRADING_RUNTIME_DRAIN_SECONDS=15
PIPELINE_CYCLE_LEASE_SECONDS=300
OPERATIONS_ACCOUNT_FRESHNESS_MINUTES=10
# TRADING_PYTHON_BINARY=/absolute/path/to/backtest/venv/bin/python
PAPER_TAKER_FEE_BPS=60
PAPER_FEE_SCENARIO=coinbase_taker_snapshot
PAPER_SLIPPAGE_SCENARIO=observed_quote

