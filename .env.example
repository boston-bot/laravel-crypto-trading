APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_SCHEMA=mcp_trading
DB_USERNAME=admin
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BROKER=coinbase
BROKER_MODE=paper
TRADING_ENABLED=false
HUMAN_APPROVAL_REQUIRED=true
TRADING_ALLOWED_ASSETS=BTC,ETH
MAX_OPEN_POSITIONS=1
MAX_POSITION_NOTIONAL_USD=15
MAX_DAILY_LOSS_PCT=2
MAX_WEEKLY_LOSS_PCT=5
MAX_DRAWDOWN_PCT=8
MAX_NEW_ENTRIES_PER_DAY=1
MAX_NEW_ENTRIES_PER_WEEK=3
MAX_DAILY_NOTIONAL_PCT=30
STRATEGY_NAME=BTC_ETH_Momentum_Filtered_v1
TRADE_COOLDOWN_MINUTES=30
MAX_ACCOUNT_STALE_MINUTES=30
TRADING_KILL_SWITCH_CACHE_KEY=trading:frozen
TRADING_APPROVER_EMAILS=
TRADING_UNIVERSE_REQUIRE_HISTORY=false
TRADING_MIN_CANDLE_HISTORY=120

REGIME_BTC_TREND_THRESHOLD=0.58
REGIME_BTC_MOMENTUM_THRESHOLD=0.55
REGIME_ETH_CONFIRMATION_THRESHOLD=0.52
REGIME_BREADTH_THRESHOLD=0.55
REGIME_VOL_SHOCK_ATR_PCT=0.08
REGIME_VOL_SHOCK_QUALITY_THRESHOLD=0.35

SCORING_WEIGHT_TREND=0.30
SCORING_WEIGHT_RELATIVE_STRENGTH=0.25
SCORING_WEIGHT_MOMENTUM=0.20
SCORING_WEIGHT_VOLATILITY_QUALITY=0.15
SCORING_WEIGHT_PULLBACK_QUALITY=0.10
SCORING_WEIGHT_PARTICIPATION=0.00
SCORING_WEIGHT_EXECUTION_PENALTY=0.18

ENTRY_MAX_UNIVERSE_RANK=3
ENTRY_MAX_RSI=72
ENTRY_MAX_EXTENSION_PCT=0.03
ENTRY_MAX_ATR_PCT=0.09
ENTRY_MIN_PROBABILITY=0.52
EXIT_MAX_RSI=78

SIZING_BASE_RISK_PCT=0.0075
SIZING_NEUTRAL_REGIME_MULTIPLIER=0.60
SIZING_ATR_STOP_MULTIPLE=1.8
SIZING_DEFAULT_ATR_PCT=0.03
SIZING_MIN_STOP_DISTANCE_PCT=0.015
SIZING_DRAWDOWN_SCALE_PCT=12.0
SIZING_MAX_POSITION_PCT_EQUITY=0.25
PAPER_DEFAULT_SPREAD_BPS=35
MARKET_DATA_CANDLE_SPAN_1D=year
MARKET_DATA_CANDLE_SPAN_4H=3month

MAX_PORTFOLIO_HEAT_PCT=55
MAX_CORRELATED_EXPOSURE_PCT=70
MAX_ASSET_ATR_PCT=0.10
MAX_EXECUTION_PENALTY=0.70
MAX_SPREAD_BPS=180
MAX_SLIPPAGE_BPS=180
MAX_CONSECUTIVE_LOSSES=3
CONSECUTIVE_LOSS_LOOKBACK=8

COINBASE_BASE_URL=https://api.coinbase.com
COINBASE_API_KEY=
COINBASE_API_PRIVATE_KEY=
COINBASE_QUOTE_CURRENCY=USD
COINBASE_TIMEOUT_SECONDS=10
COINBASE_RETRY_TIMES=3
COINBASE_RETRY_SLEEP_MS=200
COINBASE_ENDPOINT_ACCOUNTS=/api/v3/brokerage/accounts
COINBASE_ENDPOINT_ASSETS=/api/v3/brokerage/products
COINBASE_ENDPOINT_ORDERS=/api/v3/brokerage/orders/historical/batch
COINBASE_ENDPOINT_ORDER=/api/v3/brokerage/orders/historical
COINBASE_ENDPOINT_PLACE_ORDER=/api/v3/brokerage/orders
COINBASE_ENDPOINT_QUOTES=/api/v3/brokerage/best_bid_ask
COINBASE_ENDPOINT_CANDLES=/api/v3/brokerage/products/{product_id}/candles

ROBINHOOD_BASE_URL=https://trading.robinhood.com
ROBINHOOD_PUBLIC_API_KEY=
ROBINHOOD_PRIVATE_API_KEY=
ROBINHOOD_X_API_KEY=
ROBINHOOD_API_KEY=
ROBINHOOD_API_SECRET=
ROBINHOOD_SIGNING_PRIVATE_KEY=
ROBINHOOD_TIMEOUT_SECONDS=10
ROBINHOOD_RETRY_TIMES=3
ROBINHOOD_RETRY_SLEEP_MS=200
ROBINHOOD_ENDPOINT_ACCOUNTS=/api/v1/crypto/trading/accounts/
ROBINHOOD_ENDPOINT_ASSETS=/api/v1/crypto/trading/trading_pairs/
ROBINHOOD_ENDPOINT_POSITIONS=/api/v1/crypto/trading/holdings/
ROBINHOOD_ENDPOINT_ORDERS=/api/v1/crypto/trading/orders/
ROBINHOOD_ENDPOINT_QUOTES=/api/v1/crypto/marketdata/best_bid_ask/
ROBINHOOD_ENDPOINT_CANDLES=/api/v1/crypto/marketdata/historicals/
COINBASE_EXCHANGE_BASE_URL=https://api.exchange.coinbase.com

# M0: disabled until deliberately configured. Operators have access to all legacy accounts.
LEGACY_CRYPTO_SCHEDULES_ENABLED=false
MCP_MONITORING_ENABLED=false
BROKERAGE_WRITES_ENABLED=false
MCP_LIVE_AUTOMATION_ENABLED=false
# Private absolute path outside schema backups/releases; provision with mcp:execution-fence before first intent.
MCP_EXECUTION_RECOVERY_DIR=
# Crypto venue writes are gated separately and stay off until an authorized crypto pilot (CRYPTO-AUTOMATION-PLAN.md C7).
COINBASE_WRITES_ENABLED=false
ROBINHOOD_CRYPTO_WRITES_ENABLED=false

# Crypto C2: manual stored-data evidence only; no paper handoff or broker order.
CRYPTO_STRATEGY_EVALUATION_ENABLED=false
# Crypto C3: scheduled 24/7 simulated paper cycle (requires the two switches above and collection). No broker order.
CRYPTO_PAPER_ENABLED=false
# Crypto C3: scheduled read-only Coinbase fee-tier refresh using the configured credential; no order or policy change.
CRYPTO_FEE_REFRESH_ENABLED=false
# Crypto C1: read-only Coinbase public market data; no credentials. Comma-separated product IDs, e.g. BTC-USD,ETH-USD (at most 25).
CRYPTO_MARKET_DATA_ENABLED=false
COINBASE_MARKET_DATA_PRODUCTS=
MCP_OPERATOR_EMAILS=

# Application-owned MCP OAuth; separate from the legacy Robinhood Crypto adapter.
ROBINHOOD_MCP_ENABLED=false
ROBINHOOD_MCP_EXECUTION_INPUTS_ENABLED=false
ROBINHOOD_MCP_REFERENCE_DATA_ENABLED=false
ROBINHOOD_MCP_WATCHLISTS_ENABLED=false
# Read-only market-wide earnings calendar (reviewed get_earnings_calendar) for the entry blackout.
ROBINHOOD_MCP_EARNINGS_ENABLED=false
# Read-only customer trade-approval setting for the live submission checks.
ROBINHOOD_MCP_APPROVAL_SETTING_ENABLED=false
ROBINHOOD_MCP_ACCOUNT_ELIGIBILITY_ENABLED=false
ROBINHOOD_MCP_REDIRECT_URI=http://127.0.0.1:8080/mcp/robinhood/callback
# Optional pre-registered public OAuth client; otherwise Connect uses discovered registration.
ROBINHOOD_MCP_CLIENT_ID=

# M3 research: disabled until the owner supplies a reviewed provider, model, credential and cost basis.
# Use an application-specific API credential; do not reuse ChatGPT, Codex or browser session credentials.
MCP_RESEARCH_ENABLED=false
MCP_PAPER_DECISIONS_ENABLED=false
MCP_PAPER_OFFLINE_SIMULATION_ENABLED=false
MCP_PAPER_MARKET_INPUTS_ENABLED=false
MCP_STRATEGY_WATCHLIST_ENABLED=false
MCP_RULE_ELIGIBILITY_ENABLED=false
# Daily symbol profiles and playbook assignment from stored history (local computation; never an entry permission).
MCP_SYMBOL_PROFILES_ENABLED=false
# Stored-data strategy evidence only; no orders or fills.
MCP_STRATEGY_SIGNALS_ENABLED=false
MCP_LIVE_EXIT_SIGNALS_ENABLED=false
# Requires explicitly applied signal risk/cost settings and real-data paper fills; never live orders.
MCP_SIGNAL_PAPER_HANDOFF_ENABLED=false
MCP_PAPER_BATCH_COLLECTION_ENABLED=false
MCP_PAPER_SESSION_VALUATIONS_ENABLED=false
MCP_EXTERNAL_ORDER_DETECTION_ENABLED=false
MCP_PAPER_MARKET_COLLECTION_ENABLED=false
MCP_PAPER_HANDOFF_ENABLED=false
MCP_PAPER_REAL_DATA_FILLS_ENABLED=false
MCP_PAPER_ACTIONS_ENABLED=false
# Derive stock/ETF and leveraged/inverse eligibility from broker type plus stored SEC filing evidence.
MCP_PAPER_CLASSIFICATION_ENABLED=false
MCP_RESEARCH_PROVIDER=openai
MCP_RESEARCH_MODEL=
MCP_RESEARCH_API_KEY=
# Reviewed provider pricing (quoted decimal USD per million tokens) and all fixed monthly AI/data subscriptions.
MCP_RESEARCH_INPUT_COST_PER_MTOK=
MCP_RESEARCH_OUTPUT_COST_PER_MTOK=
MCP_RESEARCH_FIXED_MONTHLY_COSTS=
# Planning target 100.00; values above the 150.00 ceiling are rejected.
MCP_RESEARCH_MONTHLY_ENVELOPE=100.00

# M4 operations: enable only on the deployed runtime, never in a development checkout.
MCP_OPERATIONS_ENABLED=false
MCP_NTFY_URL=https://ntfy.sh
# Long random topic (16-64 letters, digits, - or _). It is the shared secret on public ntfy; subscribe to it in the ntfy app.
MCP_NTFY_TOPIC=
MCP_NTFY_TOKEN=
# Healthchecks.io check ping URL; the scheduler pings it every minute and appends /fail when a critical check fails.
MCP_HEALTHCHECKS_PING_URL=
# Optional https link added to alerts (for example a private Tailscale URL).
MCP_DASHBOARD_URL=
# Off-Mac folder for encrypted backup copies, for example a Google Drive for desktop folder.
MCP_BACKUP_OFFSITE_DIR=
# Optional overrides: MCP_BACKUP_DIR, MCP_BACKUP_KEY_FILE, MCP_PG_BIN_DIR, MCP_RESTORE_DRILL_DB_USER, MCP_RESTORE_DRILL_DB_HOST

# Optional read-only Alpaca corporate-action data. Keys are separate from Robinhood authorization.
ALPACA_DATA_ENABLED=false
ALPACA_KEY=
ALPACA_SECRET=
# Read-only listing (asset reference) and split-adjusted SIP daily bars for rule eligibility. Separate default-off gate.
# "paper" uses paper-api.alpaca.markets for asset lookups (PK… keys); "live" uses api.alpaca.markets (AK… keys).
ALPACA_REFERENCE_ENABLED=false
ALPACA_ACCOUNT_ENVIRONMENT=paper
# Read-only XNYS session calendar (daily refresh). Replaces hand-loaded session manifests when enabled.
ALPACA_CALENDAR_ENABLED=false

# Optional public SEC EDGAR classification reads (N-CEN Item C.3.c / rule 18f-4). No key; SEC fair access
# requires a declared tool identity with an operator contact, for example "Local paper monitor ops@example.com".
SEC_EDGAR_ENABLED=false
SEC_EDGAR_USER_AGENT=

# Manual historical quote research only; no scheduler or paper/live orders.
MCP_HISTORICAL_QUOTE_REPLAY_ENABLED=false

# Manual durable historical research only; needs a separate experiments worker.
MCP_STRATEGY_EXPERIMENTS_ENABLED=false

# Bounded regular-session reference/profile repair for watchlist additions.
MCP_INTRADAY_SYMBOL_WARMUP_ENABLED=false
