SCORECARD_BACKTEST_MIN_SHARPE=1.00
SCORECARD_BACKTEST_MAX_DRAWDOWN_PCT=15
SCORECARD_BACKTEST_MIN_WIN_RATE_PCT=45
SCORECARD_BACKTEST_MIN_PROFIT_FACTOR=1.15
SCORECARD_PAPER_MIN_DAYS=21
SCORECARD_PAPER_MIN_SNAPSHOTS=30
SCORECARD_PAPER_MIN_TRADES=15
SCORECARD_PAPER_MIN_SHARPE=0.75
SCORECARD_PAPER_MAX_DRAWDOWN_PCT=10
SCORECARD_PAPER_MIN_HIT_RATE_PCT=45
