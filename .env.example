APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel_crypto_trading
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BROKER=coinbase
BROKER_MODE=paper
TRADING_ENABLED=false
HUMAN_APPROVAL_REQUIRED=true
TRADING_ALLOWED_ASSETS=BTC,ETH
MAX_OPEN_POSITIONS=1
MAX_POSITION_NOTIONAL_USD=15
MAX_DAILY_LOSS_PCT=2
MAX_WEEKLY_LOSS_PCT=5
MAX_DRAWDOWN_PCT=8
MAX_NEW_ENTRIES_PER_DAY=1
MAX_NEW_ENTRIES_PER_WEEK=3
MAX_DAILY_NOTIONAL_PCT=30
STRATEGY_NAME=BTC_ETH_Momentum_Filtered_v1
TRADE_COOLDOWN_MINUTES=30
MAX_ACCOUNT_STALE_MINUTES=30
TRADING_KILL_SWITCH_CACHE_KEY=trading:frozen
TRADING_APPROVER_EMAILS=
TRADING_UNIVERSE_REQUIRE_HISTORY=false
TRADING_MIN_CANDLE_HISTORY=120

REGIME_BTC_TREND_THRESHOLD=0.58
REGIME_BTC_MOMENTUM_THRESHOLD=0.55
REGIME_ETH_CONFIRMATION_THRESHOLD=0.52
REGIME_BREADTH_THRESHOLD=0.55
REGIME_VOL_SHOCK_ATR_PCT=0.08
REGIME_VOL_SHOCK_QUALITY_THRESHOLD=0.35

SCORING_WEIGHT_TREND=0.30
SCORING_WEIGHT_RELATIVE_STRENGTH=0.25
SCORING_WEIGHT_MOMENTUM=0.20
SCORING_WEIGHT_VOLATILITY_QUALITY=0.15
SCORING_WEIGHT_PULLBACK_QUALITY=0.10
SCORING_WEIGHT_PARTICIPATION=0.00
SCORING_WEIGHT_EXECUTION_PENALTY=0.18

ENTRY_MAX_UNIVERSE_RANK=3
ENTRY_MAX_RSI=72
ENTRY_MAX_EXTENSION_PCT=0.03
ENTRY_MAX_ATR_PCT=0.09
ENTRY_MIN_PROBABILITY=0.52
EXIT_MAX_RSI=78

SIZING_BASE_RISK_PCT=0.0075
SIZING_NEUTRAL_REGIME_MULTIPLIER=0.60
SIZING_ATR_STOP_MULTIPLE=1.8
SIZING_DEFAULT_ATR_PCT=0.03
SIZING_MIN_STOP_DISTANCE_PCT=0.015
SIZING_DRAWDOWN_SCALE_PCT=12.0
SIZING_MAX_POSITION_PCT_EQUITY=0.25
PAPER_DEFAULT_SPREAD_BPS=35
MARKET_DATA_CANDLE_SPAN_1D=year
MARKET_DATA_CANDLE_SPAN_4H=3month

MAX_PORTFOLIO_HEAT_PCT=55
MAX_CORRELATED_EXPOSURE_PCT=70
MAX_ASSET_ATR_PCT=0.10
MAX_EXECUTION_PENALTY=0.70
MAX_SPREAD_BPS=180
MAX_SLIPPAGE_BPS=180
MAX_CONSECUTIVE_LOSSES=3
CONSECUTIVE_LOSS_LOOKBACK=8

COINBASE_BASE_URL=https://api.coinbase.com
COINBASE_API_KEY=
COINBASE_API_PRIVATE_KEY=
COINBASE_QUOTE_CURRENCY=USD
COINBASE_TIMEOUT_SECONDS=10
COINBASE_RETRY_TIMES=3
COINBASE_RETRY_SLEEP_MS=200
COINBASE_ENDPOINT_ACCOUNTS=/api/v3/brokerage/accounts
COINBASE_ENDPOINT_ASSETS=/api/v3/brokerage/products
COINBASE_ENDPOINT_ORDERS=/api/v3/brokerage/orders/historical/batch
COINBASE_ENDPOINT_ORDER=/api/v3/brokerage/orders/historical
COINBASE_ENDPOINT_PLACE_ORDER=/api/v3/brokerage/orders
COINBASE_ENDPOINT_QUOTES=/api/v3/brokerage/best_bid_ask
COINBASE_ENDPOINT_CANDLES=/api/v3/brokerage/products/{product_id}/candles

ROBINHOOD_BASE_URL=https://trading.robinhood.com
ROBINHOOD_PUBLIC_API_KEY=
ROBINHOOD_PRIVATE_API_KEY=
ROBINHOOD_X_API_KEY=
ROBINHOOD_API_KEY=
ROBINHOOD_API_SECRET=
ROBINHOOD_SIGNING_PRIVATE_KEY=
ROBINHOOD_TIMEOUT_SECONDS=10
ROBINHOOD_RETRY_TIMES=3
ROBINHOOD_RETRY_SLEEP_MS=200
ROBINHOOD_ENDPOINT_ACCOUNTS=/api/v1/crypto/trading/accounts/
ROBINHOOD_ENDPOINT_ASSETS=/api/v1/crypto/trading/trading_pairs/
ROBINHOOD_ENDPOINT_POSITIONS=/api/v1/crypto/trading/holdings/
ROBINHOOD_ENDPOINT_ORDERS=/api/v1/crypto/trading/orders/
ROBINHOOD_ENDPOINT_QUOTES=/api/v1/crypto/marketdata/best_bid_ask/
