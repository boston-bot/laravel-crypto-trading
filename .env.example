SCORECARD_PAPER_MAX_AVG_SLIPPAGE_BPS=75
SCORECARD_OPS_MAX_CRITICAL_RISK_EVENTS=0
SCORECARD_OPS_MAX_REJECTED_RATE_PCT=10
